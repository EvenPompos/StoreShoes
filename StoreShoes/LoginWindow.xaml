<Window x:Class="StoreShoes.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StoreShoes"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800" 
        Icon="/Images/Icon.JPG"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Авторизация" FontSize="32" HorizontalAlignment="Center" Margin="0 30 0 0"></TextBlock>
        <Grid Grid.Row="1">
            <StackPanel>
                <TextBlock Text="Login:" FontSize="24" HorizontalAlignment="Left" Margin="20 10 0 0"></TextBlock>
                <TextBox x:Name="txtLogin"  Width="400" FontSize="24" HorizontalAlignment="Left" Margin="20 10 0 0" ></TextBox>
                <TextBlock Text="Password:" FontSize="24" HorizontalAlignment="Left" Margin="20 10 0 0"></TextBlock>
                <PasswordBox x:Name="txtPassword" Width="400" FontSize="24" HorizontalAlignment="Left" Margin="20 10 0 0"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="LoginBut" Content="Вход" Width="200" Height="50" FontSize="24" Margin="50 0 0 0" Click="LoginBut_Click" Background="#7FFF00"></Button>
                <Button x:Name="GuestBut" Content="Гость" Width="200" Height="50" FontSize="24" Margin="50 0 0 0" Click="GuestBut_Click" Background="#7FFF00"></Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
