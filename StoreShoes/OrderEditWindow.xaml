<Window x:Class="StoreShoes.Views.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление заказом" Height="450" Width="500" WindowStartupLocation="CenterScreen" Closed="Window_Closed">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Код (Артикул):" Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="tbCode" Grid.Row="0" Grid.Column="1" Margin="5" Height="25"/>

        <TextBlock Text="Клиент:" Grid.Row="1" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <ComboBox x:Name="cbUser" Grid.Row="1" Grid.Column="1" Margin="5" Height="25" DisplayMemberPath="FIO"/>

        <TextBlock Text="Статус заказа:" Grid.Row="2" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <ComboBox x:Name="cbStatus" Grid.Row="2" Grid.Column="1" Margin="5" Height="25" DisplayMemberPath="OrderStatusesName"/>

        <TextBlock Text="Пункт выдачи:" Grid.Row="3" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <ComboBox x:Name="cbPoint" Grid.Row="3" Grid.Column="1" Margin="5" Height="25" DisplayMemberPath="PointVudachiesName"/>

        <TextBlock Text="Дата заказа:" Grid.Row="4" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <DatePicker x:Name="dpOrderDate" Grid.Row="4" Grid.Column="1" Margin="5" Height="25"/>

        <TextBlock Text="Дата выдачи:" Grid.Row="5" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <DatePicker x:Name="dpDeliveryDate" Grid.Row="5" Grid.Column="1" Margin="5" Height="25"/>

        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,20,0,0">
            <Button x:Name="btnDelete" Content="Удалить" Width="100" Height="30" Margin="0,0,10,0" Background="#FFB2B2" Click="btnDelete_Click"/>
            <Button x:Name="btnSave" Content="Сохранить" Width="100" Height="30" Click="btnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>