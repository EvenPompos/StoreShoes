<Window x:Class="StoreShoes.Views.TovarEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление товаром" Height="550" Width="800" WindowStartupLocation="CenterScreen" Closed="Window_Closed"
        Icon="/Images/Icon.JPG">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Image x:Name="imgPhoto" Height="200" Width="200" Stretch="Uniform" Margin="0,0,0,10"/>
            <Button Content="Изменить фото" Height="30" Click="btnSelectPhoto_Click"/>
            <TextBlock Text="Макс. 300x200 пикселей" Foreground="Gray" HorizontalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="15,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Артикул:" Grid.Row="0" Grid.Column="0" Margin="5"/>
            <TextBox x:Name="tbArticle" Grid.Row="0" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Наименование:" Grid.Row="1" Grid.Column="0" Margin="5"/>
            <ComboBox x:Name="cbName" Grid.Row="1" Grid.Column="1" Margin="5" DisplayMemberPath="TovarName"/>

            <TextBlock Text="Категория:" Grid.Row="2" Grid.Column="0" Margin="5"/>
            <ComboBox x:Name="cbCategory" Grid.Row="2" Grid.Column="1" Margin="5" DisplayMemberPath="CategoriesName"/>

            <TextBlock Text="Поставщик:" Grid.Row="3" Grid.Column="0" Margin="5"/>
            <ComboBox x:Name="cbPostavshik" Grid.Row="3" Grid.Column="1" Margin="5" DisplayMemberPath="PostavshikesName"/>

            <TextBlock Text="Производитель:" Grid.Row="4" Grid.Column="0" Margin="5"/>
            <ComboBox x:Name="cbManufacture" Grid.Row="4" Grid.Column="1" Margin="5" DisplayMemberPath="ManufacturesName"/>

            <TextBlock Text="Цена / Скидка / Остаток:" Grid.Row="5" Grid.Column="0" Margin="5"/>
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="5">
                <TextBox x:Name="tbPrice" Width="70" Margin="0,0,10,0"/>
                <TextBox x:Name="tbSkidka" Width="50" Margin="0,0,10,0"/>
                <TextBox x:Name="tbOstatok" Width="50"/>
            </StackPanel>

            <TextBlock Text="Ед. измерения:" Grid.Row="6" Grid.Column="0" Margin="5"/>
            <TextBox x:Name="tbEd" Grid.Row="6" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Описание:" Grid.Row="7" Grid.Column="0" Margin="5"/>
            <TextBox x:Name="tbOpisanie" Grid.Row="7" Grid.Column="1" Margin="5" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>

            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button x:Name="btnDelete" Content="Удалить" Width="100" Height="30" Margin="0,0,10,0" Background="#FFB2B2" Click="btnDelete_Click"/>
                <Button x:Name="btnSave" Content="Сохранить" Width="100" Height="30" Click="btnSave_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>