<Page x:Class="StoreShoes.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StoreShoes.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage"
      Loaded="Page_Loaded">

    <Grid>
        <ListView x:Name="ListMain">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="50"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="{Binding PhotoPath}"></Image>
                        <StackPanel 
                            Grid.Column="1"
                            Margin="10 5 0 0"
                            Background="{Binding Fon}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Categories.CategoriesName}" Margin="5"></TextBlock>
                                <TextBlock Text="{Binding TovarNames.TovarName}" Margin="5"></TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Описание:" Margin="5"></TextBlock>
                                <TextBlock Text="{Binding Opisanie}" Margin="5"></TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Производитель:" Margin="5"></TextBlock>
                                <TextBlock Text="{Binding Manufactures.ManufacturesName}" Margin="5"></TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Поставщик:" Margin="5"></TextBlock>
                                <TextBlock Text="{Binding Postavshikes.PostavshikesName}"  Margin="5"></TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="5" Text="Цена:"></TextBlock>
                                <TextBlock Margin="5" Text="{Binding Price}" Visibility="{Binding OldPrice}" Foreground="Red" TextDecorations="Strikethrough"></TextBlock>
                                <TextBlock Margin="5" Text="{Binding TotalPrice}"></TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="5" Text="Ед.измерения:"></TextBlock>
                                <TextBlock Margin="5" Text="{Binding EdIzmereniya}"></TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="5" Text="Склад:"></TextBlock>
                                <TextBlock Margin="5" Text="{Binding Ostatok}"></TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Column="2">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Margin="5" Text="{Binding Skidka}"></TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
