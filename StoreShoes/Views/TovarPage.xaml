<Page x:Class="StoreShoes.Views.TovarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Товары" Loaded="Page_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ПАНЕЛЬ ПОИСКА, ФИЛЬТРАЦИИ И СОРТИРОВКИ -->
        <WrapPanel Grid.Row="0" Margin="10">
            <StackPanel Margin="0 0 20 0">
                <TextBlock Text="Поиск (по всем полям):"/>
                <TextBox x:Name="txtSearch" Width="200" TextChanged="FilterElements_Changed"/>
            </StackPanel>

            <StackPanel Margin="0 0 20 0">
                <TextBlock Text="Фильтр (Поставщик):"/>
                <ComboBox x:Name="cbFilter" Width="150" SelectionChanged="FilterElements_Changed" DisplayMemberPath="PostavshikesName"/>
            </StackPanel>

            <StackPanel Margin="0 0 20 0">
                <TextBlock Text="Сортировка (Остаток):"/>
                <ComboBox x:Name="cbSort" Width="150" SelectionChanged="FilterElements_Changed">
                    <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                    <ComboBoxItem Content="По возрастанию"/>
                    <ComboBoxItem Content="По убыванию"/>
                </ComboBox>
            </StackPanel>
        </WrapPanel>

        <!-- ТАБЛИЦА ТОВАРОВ -->
        <DataGrid x:Name="dgTovars" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="dgTovars_MouseDoubleClick" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Артикул" Binding="{Binding Article}"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding TovarNames.TovarName}"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Categories.CategoriesName}"/>
                <DataGridTextColumn Header="Поставщик" Binding="{Binding Postavshikes.PostavshikesName}"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}"/>
                <DataGridTextColumn Header="Остаток" Binding="{Binding Ostatok}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- КНОПКА ДОБАВЛЕНИЯ -->
        <Button x:Name="btnAdd" Grid.Row="2" Content="Добавить товар" Width="200" Height="40" Margin="10" HorizontalAlignment="Right" Click="btnAdd_Click" Visibility="Collapsed"/>
    </Grid>
</Page>